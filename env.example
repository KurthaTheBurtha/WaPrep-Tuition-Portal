# Django Settings
SECRET_KEY=your-secret-key-here-make-it-long-and-random-at-least-50-characters
DEBUG=False

# Database (will be set by Railway/Render)
DATABASE_URL=postgresql://user:password@host:port/database

# Email Settings
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@example.com

# Stripe Settings
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Security Settings (Production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# Admin Token (for superuser creation in staging)
SUPERUSER_TOKEN=your-secure-admin-token-here 